<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>Astar.Vanguard.Server</AssemblyName>
    <AssemblyCompany>Astar</AssemblyCompany>
    <AssemblyProduct>Astar Vanguard</AssemblyProduct>
    <AssemblyCopyright>Copyright © Astar 2025 - 2026</AssemblyCopyright> 
    <AssemblyTitle>Astar Vanguard Server</AssemblyTitle>
    <Version>0.2.0.0</Version>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <RootNamespace>Astar.Vanguard.Server</RootNamespace>
    <NoWarn>CS0618;CS8632;CS9107</NoWarn>
  </PropertyGroup>
  <ItemGroup>
      <Content Include="Assets\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.0.0" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.0" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.0.0" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.0" />
    <PackageReference Include="SPTarkov.Server.Web" Version="4.0.0" />
  </ItemGroup>
</Project>
